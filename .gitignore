owned_group.txt
staff_groups.txt
group_staff.txt
group_whitelist.txt
blacklist.txt
flagged_words.txt
group_blacklist.txt
group_blacklist.txt.txt
restricted_area_markers.txt
rip_suspicion_markers.txt
world_restricted_areas.txt

